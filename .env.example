# Names only. Put real values in the host settings or a local file that git ignores.
# Never commit values. Worker variables are read as env.<NAME> in app/ and worker/.

# D1 database binding. The code reads it as env.DB. It is a binding, not a text value.
# Local runs use `d1 execute DB --local` (RUN_LOCAL.md). Cloudflare: DEPLOY_CLOUDFLARE.md.

# Optional. Name of the header that holds the real client IP, for rate limits (app/auth.ts clientIp).
# Set it only behind your own reverse proxy that overwrites that header. EC2 service uses x-real-ip.
TRUST_PROXY_HEADER=

# Build-time names for a Cloudflare build. They are read from process.env in vite.config.ts (not from env.<NAME> at run time).
# Optional. Name of the Cloudflare Worker.
WORKER_NAME=
# Optional. Name of the D1 database (default site-creator-d1).
D1_DATABASE_NAME=
# Optional. ID of the D1 database; a placeholder is used when unset.
D1_DATABASE_ID=
